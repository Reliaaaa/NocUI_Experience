<UserControl
    x:Class="NotchWindows.App.Views.Panels.MusicPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- F-010, F-011, F-012 — now playing SMTC -->
    <StackPanel Spacing="8">
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="8" Background="{StaticResource NotchAccentBrush}" Opacity="0.3" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource NotchPrimaryTextStyle}" Text="{x:Bind ViewModel.Track.Title, Mode=OneWay, TargetNullValue='Tidak ada lagu'}" />
                <TextBlock Style="{StaticResource NotchSecondaryTextStyle}" Text="{x:Bind ViewModel.Track.Artist, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <ProgressBar Value="{x:Bind ViewModel.ProgressRatio, Mode=OneWay}" Maximum="1" Height="3" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
            <Button Content="⏮" Command="{x:Bind ViewModel.PreviousCommand}" />
            <Button Content="{x:Bind ViewModel.IsPlaying, Mode=OneWay, Converter={StaticResource PlayPauseGlyphConverter}}"
                    Command="{x:Bind ViewModel.PlayPauseCommand}" />
            <Button Content="⏭" Command="{x:Bind ViewModel.NextCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
