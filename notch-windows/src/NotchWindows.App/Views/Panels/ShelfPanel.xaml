<UserControl
    x:Class="NotchWindows.App.Views.Panels.ShelfPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- F-005a drag-and-drop file, F-030 app launcher pin (P1/P2 — UI dasar, logic drop lengkap di Rilis 2) -->
    <Grid AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
        <TextBlock Style="{StaticResource NotchSecondaryTextStyle}"
                   Text="Drop file di sini, atau pin aplikasi favorit (segera)"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" TextAlignment="Center" />
    </Grid>
</UserControl>
