<Window
    x:Class="NotchWindows.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- F-050 — posisi notch, info kiri/kanan, shortcut, tema dasar -->
    <ScrollViewer Padding="20">
        <StackPanel Spacing="16" MaxWidth="480">
            <TextBlock Text="Pengaturan" FontSize="20" FontWeight="SemiBold" />

            <ComboBox Header="Posisi notch"
                      ItemsSource="{x:Bind PositionOptions}"
                      SelectedItem="{x:Bind ViewModel.Position, Mode=TwoWay}" />

            <ComboBox Header="Info kiri (closed notch)"
                      ItemsSource="{x:Bind MetricOptions}"
                      SelectedItem="{x:Bind ViewModel.LeftMetric, Mode=TwoWay}" />

            <ComboBox Header="Info kanan (closed notch)"
                      ItemsSource="{x:Bind MetricOptions}"
                      SelectedItem="{x:Bind ViewModel.RightMetric, Mode=TwoWay}" />

            <TextBox Header="Shortcut global" Text="{x:Bind ViewModel.Shortcut, Mode=TwoWay}" />

            <ToggleSwitch Header="Format jam 24 jam" IsOn="{x:Bind ViewModel.Use24HourClock, Mode=TwoWay}" />

            <ComboBox Header="Tema"
                      ItemsSource="{x:Bind ThemeOptions}"
                      SelectedItem="{x:Bind ViewModel.Theme, Mode=TwoWay}" />

            <Button Content="Simpan" Command="{x:Bind ViewModel.SaveCommand}" HorizontalAlignment="Left" />
        </StackPanel>
    </ScrollViewer>
</Window>
