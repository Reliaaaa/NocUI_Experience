<!--
  Palet & brush ORIGINAL untuk notch-windows — terinspirasi estetika dark/glass-morphism umum
  (pill rounded, blur, kontras tinggi), BUKAN salinan warna/aset milik aplikasi pihak ketiga.
  Lihat docs/03-design.md untuk spesifikasi lengkap.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="NotchBackgroundColor">#CC121214</Color>
    <Color x:Key="NotchBorderColor">#33FFFFFF</Color>
    <Color x:Key="NotchAccentColor">#6E7BFF</Color>
    <Color x:Key="NotchTextPrimaryColor">#FFFFFFFF</Color>
    <Color x:Key="NotchTextSecondaryColor">#99FFFFFF</Color>
    <Color x:Key="DockBackgroundColor">#CC121214</Color>
    <Color x:Key="NotchPillBackgroundColor">#CC121214</Color>

    <SolidColorBrush x:Key="NotchBackgroundBrush" Color="{StaticResource NotchBackgroundColor}" />
    <SolidColorBrush x:Key="NotchBorderBrush" Color="{StaticResource NotchBorderColor}" />
    <SolidColorBrush x:Key="NotchAccentBrush" Color="{StaticResource NotchAccentColor}" />
    <SolidColorBrush x:Key="NotchTextPrimaryBrush" Color="{StaticResource NotchTextPrimaryColor}" />
    <SolidColorBrush x:Key="NotchTextSecondaryBrush" Color="{StaticResource NotchTextSecondaryColor}" />
    <SolidColorBrush x:Key="DockBackgroundBrush" Color="{StaticResource DockBackgroundColor}" />
    <SolidColorBrush x:Key="NotchPillBackgroundBrush" Color="{StaticResource NotchPillBackgroundColor}" />

    <CornerRadius x:Key="NotchCollapsedCornerRadius">16</CornerRadius>
    <x:Double x:Key="NotchExpandedCornerRadius">24</x:Double>
    <CornerRadius x:Key="DockCornerRadius">20</CornerRadius>

</ResourceDictionary>
