<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Bentuk pill notch ORIGINAL untuk proyek ini — bukan aset/file dari aplikasi pihak ketiga.
        Geometry sederhana: rounded rect lebar closed-state, radius penuh di kedua sisi bawah.
        TODO: tune ukuran/radius final saat implementasi NotchWindow (lihat 03-design.md).
    -->
    <x:Double x:Key="NotchClosedHeight">32</x:Double>
    <x:Double x:Key="NotchClosedCornerRadius">16</x:Double>
    <x:Double x:Key="NotchExpandedCornerRadius">24</x:Double>

    <CornerRadius x:Key="NotchClosedRadius">0,0,16,16</CornerRadius>
    <CornerRadius x:Key="NotchExpandedRadius">24</CornerRadius>

</ResourceDictionary>
