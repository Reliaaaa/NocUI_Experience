<Window
    x:Class="NotchUI.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="Transparent">
        <Border x:Name="Pill" Background="Black" HorizontalAlignment="Center" VerticalAlignment="Top"
                PointerEntered="OnPointerEntered" PointerExited="OnPointerExited">
            <StackPanel Spacing="8" Padding="12,4">
                <Grid x:Name="NotchHeader" Tapped="OnHeaderTapped">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SummaryText" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ClockText" Grid.Column="1" Foreground="White" Margin="12,0,0,0" VerticalAlignment="Center" />
                </Grid>
                <StackPanel x:Name="ExpandedContent" Visibility="Collapsed" Spacing="4">
                    <TextBlock x:Name="BatteryText" Foreground="White" />
                    <TextBlock x:Name="MediaText" Foreground="White" TextTrimming="CharacterEllipsis" />
                    <StackPanel x:Name="MediaControls" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="PreviousButton" Content="Previous" Click="OnPreviousClicked" />
                        <Button x:Name="PlayPauseButton" Content="Play/Pause" Click="OnPlayPauseClicked" />
                        <Button x:Name="NextButton" Content="Next" Click="OnNextClicked" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
