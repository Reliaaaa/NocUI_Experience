<Window
    x:Class="NotchUI.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="Transparent">
        <Border x:Name="Pill" Background="Black" HorizontalAlignment="Center" VerticalAlignment="Top"
                PointerEntered="OnPointerEntered" PointerExited="OnPointerExited">
            <StackPanel Spacing="8" Padding="16,6">
                <Button x:Name="HeaderButton" AutomationProperties.Name="Open or close notch" Click="OnHeaderClicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0" Background="Transparent" BorderThickness="0" MinHeight="0">
                <Grid x:Name="NotchHeader">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SummaryText" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ClockText" Grid.Column="1" Foreground="White" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="CompactBatteryText" Grid.Column="2" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center" />
                </Grid>
                </Button>
                <StackPanel x:Name="ExpandedContent" Visibility="Collapsed" Spacing="4">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="DateText" Foreground="White" Opacity="0.75" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="BatteryText" Grid.Column="1" Foreground="White" Opacity="0.75" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <TextBlock x:Name="MediaText" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MediaArtistText" Foreground="White" Opacity="0.75" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                    <StackPanel x:Name="MediaControls" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="PreviousButton" AutomationProperties.Name="Previous track" Click="OnPreviousClicked"><FontIcon Glyph="&#xE892;" /></Button>
                        <Button x:Name="PlayPauseButton" AutomationProperties.Name="Play or pause" Click="OnPlayPauseClicked"><FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" /></Button>
                        <Button x:Name="NextButton" AutomationProperties.Name="Next track" Click="OnNextClicked"><FontIcon Glyph="&#xE893;" /></Button>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
