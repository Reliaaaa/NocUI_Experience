<Window
    x:Class="NotchUI.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="Transparent">
        <Border x:Name="Pill" Background="Black" HorizontalAlignment="Center" VerticalAlignment="Top"
                PointerEntered="OnPointerEntered" PointerExited="OnPointerExited">
            <!-- Flutter's island palette: quiet surface, 14 pt cards, restrained typography.
                 Use native buttons so keyboard focus and disabled states stay accessible. -->
            <Grid Padding="14,6" RowSpacing="10">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Button x:Name="HeaderButton" AutomationProperties.Name="Open or close notch" Click="OnHeaderClicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0" Background="Transparent" BorderThickness="0" MinHeight="0">
                    <Grid x:Name="NotchHeader" ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="SummaryText" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ClockText" Grid.Column="1" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="CompactBatteryText" Grid.Column="2" FontSize="12" VerticalAlignment="Center" />
                    </Grid>
                </Button>
                <ScrollViewer x:Name="ExpandedContent" Grid.Row="1" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                    <StackPanel Spacing="10" Padding="0,0,0,8">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="DateText" FontSize="12" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="BatteryText" Grid.Column="1" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <Border x:Name="MediaCard" CornerRadius="14" Padding="14">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="MediaLabel" Text="Media" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock x:Name="MediaText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="MediaArtistText" FontSize="12" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                                <StackPanel x:Name="MediaControls" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,4,0,0">
                                    <Button x:Name="PreviousButton" Width="40" Height="40" Padding="0" CornerRadius="11" AutomationProperties.Name="Previous track" ToolTipService.ToolTip="Previous track" Click="OnPreviousClicked"><FontIcon FontSize="16" Glyph="&#xE892;" /></Button>
                                    <Button x:Name="PlayPauseButton" Width="40" Height="40" Padding="0" CornerRadius="11" AutomationProperties.Name="Play or pause" ToolTipService.ToolTip="Play or pause" Click="OnPlayPauseClicked"><FontIcon x:Name="PlayPauseIcon" FontSize="20" Glyph="&#xE768;" /></Button>
                                    <Button x:Name="NextButton" Width="40" Height="40" Padding="0" CornerRadius="11" AutomationProperties.Name="Next track" ToolTipService.ToolTip="Next track" Click="OnNextClicked"><FontIcon FontSize="16" Glyph="&#xE893;" /></Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border x:Name="FocusCard" CornerRadius="14" Padding="14">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="PomodoroText" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button x:Name="PomodoroToggle" Grid.Column="1" Content="Start" MinHeight="40" CornerRadius="11" Click="OnPomodoroToggle" AutomationProperties.HelpText="Start or pause the focus timer" />
                                <Button x:Name="PomodoroReset" Grid.Column="2" Content="Reset" MinHeight="40" CornerRadius="11" Click="OnPomodoroReset" AutomationProperties.Name="Reset focus timer" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
