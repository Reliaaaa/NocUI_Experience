<Window
    x:Class="NotchUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NotchUI Settings">
    <ScrollViewer>
        <StackPanel Spacing="18" Padding="28" MaxWidth="700" HorizontalAlignment="Center">
            <TextBlock Text="NotchUI" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Appearance and modules" Style="{StaticResource SubtitleTextBlockStyle}" />
            <InfoBar x:Name="SettingsError" Severity="Warning" IsOpen="False" />
            <TextBlock Text="Notch width" />
            <Slider x:Name="WidthSlider" Minimum="200" Maximum="520" StepFrequency="1" ValueChanged="OnSliderChanged" AutomationProperties.Name="Notch width" />
            <TextBlock Text="Notch height" />
            <Slider x:Name="HeightSlider" Minimum="28" Maximum="64" StepFrequency="1" ValueChanged="OnSliderChanged" AutomationProperties.Name="Notch height" />
            <TextBlock Text="Corner radius" />
            <Slider x:Name="RadiusSlider" Minimum="0" Maximum="32" StepFrequency="1" ValueChanged="OnSliderChanged" AutomationProperties.Name="Corner radius" />
            <TextBlock Text="Background color" />
            <ColorPicker x:Name="BackgroundPicker" IsAlphaEnabled="False" IsAlphaSliderVisible="False" ColorChanged="OnColorChanged" />
            <ToggleSwitch x:Name="ClockToggle" Header="Clock" Toggled="OnModulesChanged" />
            <ToggleSwitch x:Name="BatteryToggle" Header="Battery" Toggled="OnModulesChanged" />
            <ToggleSwitch x:Name="MediaToggle" Header="Media controls" Toggled="OnModulesChanged" />
            <TextBlock Text="Closing this window keeps the notch running. Use the tray icon to open settings or exit." TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Window>
