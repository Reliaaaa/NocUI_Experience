<Window x:Class="NotchUI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NocUI Experience Settings">
    <NavigationView Background="#131313" RequestedTheme="Dark" IsSettingsVisible="False" IsBackButtonVisible="Collapsed" SelectionChanged="OnNavigationChanged">
        <NavigationView.PaneHeader>
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="12,12,0,20">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="NocUI" FontSize="24" />
                    <TextBlock Text="EXPERIENCE" Foreground="#86BFF0" FontSize="10" />
                </StackPanel>
            </StackPanel>
        </NavigationView.PaneHeader>
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Appearance" Tag="appearance" Icon="Setting" IsSelected="True" />
            <NavigationViewItem Content="Widgets" Tag="widgets" Icon="AllApps" />
            <NavigationViewItem Content="Gestures &amp; Behavior" Tag="behavior" Icon="Edit" />
            <NavigationViewItem Content="Animations" Tag="animations" Icon="Play" />
            <NavigationViewItem Content="About" Tag="about" Icon="Help" />
        </NavigationView.MenuItems>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="32,28,32,48" Spacing="20" MaxWidth="940" HorizontalAlignment="Stretch">
                <TextBlock x:Name="PageTitle" Text="Appearance" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock x:Name="PageDescription" Text="Make the notch feel at home on your desktop." Opacity="0.7" TextWrapping="Wrap" Margin="0,-12,0,0" />
                <InfoBar x:Name="SettingsError" Severity="Warning" IsOpen="False" />
                <StackPanel x:Name="AppearancePage" Spacing="16">
                    <Border Background="#252B35" CornerRadius="16" Padding="20">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE7F4;" Foreground="#0078D4" />
                                <TextBlock Text="Live preview" Style="{StaticResource SubtitleTextBlockStyle}" />
                            </StackPanel>
                            <Border Height="120" Padding="12">
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                                    <Border x:Name="PreviewPill" Height="34" Width="320" MaxWidth="520" CornerRadius="16">
                                        <TextBlock x:Name="PreviewText" Text="NocUI Experience  •  Live preview" Foreground="White" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Viewbox>
                            </Border>
                            <TextBlock Text="Your changes appear here instantly" HorizontalAlignment="Center" TextWrapping="Wrap" Opacity="0.7" />
                        </StackPanel>
                    </Border>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8A9;" Foreground="#0078D4" />
                                <TextBlock Text="Dimensions" Style="{StaticResource SubtitleTextBlockStyle}" />
                            </StackPanel>
                            <TextBlock x:Name="WidthLabel" Text="Notch width" />
                            <Slider x:Name="WidthSlider" Minimum="200" Maximum="520" StepFrequency="1" ValueChanged="OnSliderChanged" AutomationProperties.Name="Notch width" AutomationProperties.LabeledBy="{Binding ElementName=WidthLabel}" AutomationProperties.HelpText="Width in device-independent pixels (DIP)." />
                            <TextBlock x:Name="HeightLabel" Text="Resting height" />
                            <Slider x:Name="HeightSlider" Minimum="28" Maximum="64" StepFrequency="1" ValueChanged="OnSliderChanged" AutomationProperties.Name="Notch height" AutomationProperties.LabeledBy="{Binding ElementName=HeightLabel}" AutomationProperties.HelpText="Resting height in device-independent pixels (DIP)." />
                            <TextBlock x:Name="RadiusLabel" Text="Corner radius" />
                            <Slider x:Name="RadiusSlider" Minimum="0" Maximum="32" StepFrequency="1" ValueChanged="OnSliderChanged" AutomationProperties.Name="Corner radius" AutomationProperties.LabeledBy="{Binding ElementName=RadiusLabel}" AutomationProperties.HelpText="Radius in device-independent pixels (DIP), limited to half the smaller notch dimension." />
                        </StackPanel>
                    </Border>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE790;" Foreground="#0078D4" />
                                <TextBlock Text="Color &amp; opacity" Style="{StaticResource SubtitleTextBlockStyle}" />
                            </StackPanel>
                            <TextBlock x:Name="OpacityLabel" Text="Background opacity" />
                            <Slider x:Name="OpacitySlider" Minimum="20" Maximum="100" StepFrequency="1" ValueChanged="OnSliderChanged" AutomationProperties.Name="Background opacity percent" AutomationProperties.LabeledBy="{Binding ElementName=OpacityLabel}" AutomationProperties.HelpText="Background opacity as a percentage." />
                            <Expander Header="Choose a background color" HorizontalAlignment="Stretch">
                                <ColorPicker x:Name="BackgroundPicker" IsAlphaEnabled="False" IsAlphaSliderVisible="False" ColorChanged="OnColorChanged" AutomationProperties.Name="Notch background color" />
                            </Expander>
                        </StackPanel>
                    </Border>
                    <Button Content="Restore defaults" HorizontalAlignment="Left" Click="OnRestoreDefaults" />
                    <Button Content="Open notch with keyboard" HorizontalAlignment="Left" Click="OnOpenNotch" />
                </StackPanel>
                <StackPanel x:Name="WidgetsPage" Visibility="Collapsed" Spacing="12">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="16" Padding="20">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Clock and date" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="Display the current time and date." TextWrapping="Wrap" Opacity="0.7" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ClockToggle" Grid.Column="1" VerticalAlignment="Center" Toggled="OnModulesChanged" AutomationProperties.Name="Clock and date widget" />
                        </Grid>
                    </Border>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="16" Padding="20">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Battery and charging" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="Show battery level and charging status." TextWrapping="Wrap" Opacity="0.7" />
                            </StackPanel>
                            <ToggleSwitch x:Name="BatteryToggle" Grid.Column="1" VerticalAlignment="Center" Toggled="OnModulesChanged" AutomationProperties.Name="Battery and charging widget" />
                        </Grid>
                    </Border>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="16" Padding="20">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Media controls" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="Control the active media session." TextWrapping="Wrap" Opacity="0.7" />
                            </StackPanel>
                            <ToggleSwitch x:Name="MediaToggle" Grid.Column="1" VerticalAlignment="Center" Toggled="OnModulesChanged" AutomationProperties.Name="Media controls widget" />
                        </Grid>
                    </Border>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="16" Padding="20">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Widgets in the notch" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Enabled widgets appear in the notch when information is available." TextWrapping="Wrap" Opacity="0.7" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="AboutPage" Visibility="Collapsed" Spacing="12">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="24">
                        <StackPanel Spacing="12">
                            <Image Source="ms-appx:///Assets/Square150x150Logo.png" Width="72" Height="72" HorizontalAlignment="Left" />
                            <TextBlock Text="NocUI Experience" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="A compact Windows desktop notch for time, battery and media." TextWrapping="Wrap" />
                            <TextBlock Text="Closing settings keeps NocUI Experience running. Use the system tray icon to reopen settings or exit." TextWrapping="Wrap" Opacity="0.7" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="BehaviorPage" Visibility="Collapsed" Spacing="12">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="16" Padding="20">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Open on hover" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="Expand after the pointer rests over the notch." TextWrapping="Wrap" Opacity="0.7" />
                            <ToggleSwitch x:Name="HoverToggle" Toggled="OnHoverChanged" AutomationProperties.Name="Open notch on hover" AutomationProperties.HelpText="Opens the notch after a brief hover and closes it after the pointer leaves." />
                        </StackPanel>
                    </Border>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="16" Padding="20">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Hover timing" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="The notch opens after a brief hover and closes shortly after you leave." TextWrapping="Wrap" Opacity="0.7" />
                        </StackPanel>
                    </Border>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="16" Padding="20">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Click the notch" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Click the header to open or close immediately." TextWrapping="Wrap" Opacity="0.7" />
                        </StackPanel>
                    </Border>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="16" Padding="20">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Keyboard" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Open from Settings, use Tab to navigate, and press Escape to close." TextWrapping="Wrap" Opacity="0.7" />
                            <Button Content="Open notch with keyboard" HorizontalAlignment="Left" Click="OnOpenNotch" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="AnimationsPage" Visibility="Collapsed" Spacing="12">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="16" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Transition duration" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="One duration applies to opening and closing. Content follows the shape as it opens and fades sooner when it closes." TextWrapping="Wrap" Opacity="0.7" />
                            <TextBlock x:Name="DurationLabel" Text="Duration" />
                            <Slider x:Name="DurationSlider" Minimum="0" Maximum="600" StepFrequency="20" ValueChanged="OnDurationChanged" AutomationProperties.Name="Animation duration in milliseconds" AutomationProperties.LabeledBy="{Binding ElementName=DurationLabel}" AutomationProperties.HelpText="Transition duration in milliseconds. Zero disables motion." />
                        </StackPanel>
                    </Border>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="16" Padding="20">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Reduce motion" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Set duration to zero for an immediate transition. The maximum is 600 ms." TextWrapping="Wrap" Opacity="0.7" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </NavigationView>
</Window>
